{
  "name": "ticketsupport-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev --color",
    "dev:stream": "turbo dev --ui=stream --color",
    "build": "turbo build --color",
    "lint": "turbo lint --color",
    "typecheck": "turbo typecheck --color",
    "test": "turbo test --color",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:studio": "npm run db:studio --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "generate:api": "npm run generate:api --workspace=web",
    "openapi:dump": "npm run openapi:dump --workspace=api",
    "codegen": "npm run openapi:dump && npm run generate:api"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "turbo": "^2.4.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "nestjs-zod": {
      "@nestjs/common": "^12.0.1",
      "@nestjs/swagger": "^12.0.4"
    }
  },
  "packageManager": "npm@10.8.2"
}
