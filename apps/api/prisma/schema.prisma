datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdTickets  Ticket[]       @relation("CreatedTickets")
  assignedTickets Ticket[]       @relation("AssignedTickets")
  comments        Comment[]

  @@index([role, fullName])
  @@map("users")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  attachmentName           String?
  attachmentMimeType       String?
  attachmentCompressed     String?
  attachmentOriginalSize   Int?
  attachmentCompressedSize Int?

  creatorId   String
  creator     User           @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  tags        TicketTag[]

  @@index([creatorId, status, title])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}
