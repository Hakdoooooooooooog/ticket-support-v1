datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum NotificationType {
  TICKET_CREATED
  TICKET_FOLLOW_UP_REQUESTED
  TICKET_CUSTOMER_AMENDED
  TICKET_NOTE_POSTED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdTickets  Ticket[]       @relation("CreatedTickets")
  assignedTickets Ticket[]       @relation("AssignedTickets")
  comments        Comment[]
  createdInvites  Invite[]       @relation("CreatedInvites")
  notifications   Notification[] @relation("UserNotifications")

  @@index([role, fullName])
  @@map("users")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(AGENT)
  code        String    @unique
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: Cascade)
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([email, code, accepted])
  @@map("invites")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  attachmentName           String?
  attachmentMimeType       String?
  attachmentCompressed     String?
  attachmentOriginalSize   Int?
  attachmentCompressedSize Int?

  creatorId   String
  creator     User           @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments      Comment[]
  tags          TicketTag[]
  notifications Notification[]

  csatRating    Int?
  csatComment   String?
  csatRatedAt   DateTime?

  @@index([creatorId, status, title])
  @@map("tickets")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachmentName           String?
  attachmentMimeType       String?
  attachmentCompressed     String?
  attachmentOriginalSize   Int?
  attachmentCompressedSize Int?

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}
