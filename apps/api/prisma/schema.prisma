datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum NotificationType {
  TICKET_CREATED
  TICKET_FOLLOW_UP_REQUESTED
  TICKET_CUSTOMER_AMENDED
  TICKET_NOTE_POSTED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  NEEDS_INFO
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Department {
  TECHNICAL_SUPPORT
  GENERAL
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  department      Department?    @default(TECHNICAL_SUPPORT)
  specialties     String[]       @default([])
  lastAssignedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdTickets    Ticket[]            @relation("CreatedTickets")
  assignedTickets   Ticket[]            @relation("AssignedTickets")
  comments          Comment[]
  createdInvites    Invite[]            @relation("CreatedInvites")
  notifications     Notification[]      @relation("UserNotifications")
  cannedResponses   CannedResponse[]    @relation("CreatedCannedResponses")
  refreshTokens     RefreshToken[]
  authoredArticles  KnowledgeArticle[]  @relation("AuthoredArticles")
  publishedArticles KnowledgeArticle[]  @relation("PublishedArticles")
  articleFeedback   ArticleFeedback[]
  deflections       ArticleDeflection[]
  createdIncidentBanners IncidentBanner[] @relation("CreatedIncidentBanners")

  @@index([role, fullName])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId, familyId, expiresAt])
  @@map("refresh_tokens")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(AGENT)
  code        String    @unique
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: Cascade)
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([email, code, accepted])
  @@map("invites")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  department  Department     @default(TECHNICAL_SUPPORT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  attachmentName           String?
  attachmentMimeType       String?
  attachmentCompressed     String?
  attachmentOriginalSize   Int?
  attachmentCompressedSize Int?
  attachmentStorageKey     String?
  attachmentStorageType    String?        @default("BASE64")
  attachmentBucket         String?

  autoEscalated            Boolean        @default(false)
  escalationReason         String?

  creatorId   String
  creator     User           @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments      Comment[]
  tags          TicketTag[]
  notifications Notification[]

  csatRating    Int?
  csatComment   String?
  csatRatedAt   DateTime?

  @@index([creatorId, status, title])
  @@index([department, status, createdAt])
  @@map("tickets")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachmentName           String?
  attachmentMimeType       String?
  attachmentCompressed     String?
  attachmentOriginalSize   Int?
  attachmentCompressedSize Int?
  attachmentStorageKey     String?
  attachmentStorageType    String?        @default("BASE64")
  attachmentBucket         String?

  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

model CannedResponse {
  id          String   @id @default(cuid())
  category    String
  label       String
  content     String
  createdById String?
  createdBy   User?    @relation("CreatedCannedResponses", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, label])
  @@map("canned_responses")
}

model KnowledgeArticle {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  summary         String
  body            String          @default("")
  steps           String[]        @default([])
  department      Department      @default(TECHNICAL_SUPPORT)
  tags            String[]        @default([])
  keywords        String[]        @default([])
  status          ArticleStatus   @default(DRAFT)
  authorId        String
  author          User            @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: Cascade)
  publishedById   String?
  publishedBy     User?           @relation("PublishedArticles", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  helpfulCount    Int             @default(0)
  unhelpfulCount  Int             @default(0)
  deflectionCount Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  feedback        ArticleFeedback[]
  deflections     ArticleDeflection[]

  @@index([status, department])
  @@map("knowledge_articles")
}

model ArticleFeedback {
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([articleId, userId])
  @@map("article_feedback")
}

model ArticleDeflection {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([articleId, createdAt])
  @@map("article_deflections")
}

model IncidentBanner {
  id               String   @id @default(cuid())
  title            String
  message          String
  severity         String   @default("WARNING")
  isActive         Boolean  @default(true)
  affectedServices String[] @default([])
  createdById      String
  createdBy        User     @relation("CreatedIncidentBanners", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, createdAt])
  @@map("incident_banners")
}
