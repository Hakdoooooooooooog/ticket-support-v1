# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ticketsupport
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/ticketsupport?schema=public"

# ==============================================================================
# Backend Configuration (NestJS)
# ==============================================================================
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
MAX_PAYLOAD_SIZE=10mb

# ==============================================================================
# Frontend & Shared Attachment Transit Encryption Configuration (Next.js + API)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ATTACHMENT_KEY=your_aes_256_gcm_attachment_transit_secret_here

# ==============================================================================
# Optional Local Seed Accounts (Or configure in gitignored apps/api/seed.local.json)
# ==============================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_password_here
SEED_ADMIN_NAME="IT Administrator"

SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=your_agent_password_here
SEED_AGENT_NAME="Support Engineer"

SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=your_customer_password_here
SEED_CUSTOMER_NAME="Demo Customer"
