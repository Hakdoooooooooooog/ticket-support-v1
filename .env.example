# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ticketsupport
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/ticketsupport?schema=public"

# ==============================================================================
# Backend Configuration (NestJS)
# ==============================================================================
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Frontend Configuration (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
